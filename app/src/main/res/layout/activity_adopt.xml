<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baby_pink"
    android:padding="16dp">

    <!-- Top Navigation Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adoptHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnAdoptBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circular_button_bg"
            android:contentDescription="Back"
            android:src="@drawable/abc_ic_ab_back_material"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#4A4A4A" />

        <TextView
            android:id="@+id/txtAdoptCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/stats_card_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="💰 100"
            android:textColor="#E65100"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/adoptTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adopt A Cat 🐱"
            android:textColor="#4A4A4A"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtAdoptCoins"
            app:layout_constraintStart_toEndOf="@+id/btnAdoptBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adoptHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="Choose your sweet new companion!"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="italic" />

            <!-- Option 1: Ginger Tabby -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/stats_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgAdopt1"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/pet_happy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ginger Tabby 🐈"
                        android:textColor="#4A4A4A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Playful, energetic &amp; high-spirited"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Free Adoption"
                        android:textColor="#388E3C"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAdopt1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adopt" />
            </LinearLayout>

            <!-- Option 2: Tuxedo Cat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/stats_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgAdopt2"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/pet_happy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuxedo Cat 🐈‍⬛"
                        android:textColor="#4A4A4A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Calm, smart &amp; fancy companion"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Price: 💰 50 Coins"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAdopt2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adopt" />
            </LinearLayout>

            <!-- Option 3: Calico Cat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/stats_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgAdopt3"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/pet_happy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calico Cat 🐱"
                        android:textColor="#4A4A4A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sweet-natured, loving &amp; loyal"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Price: 💰 50 Coins"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAdopt3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adopt" />
            </LinearLayout>

            <!-- Button to open Food Shop -->
            <Button
                android:id="@+id/btnGoToFoodShop"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#FFB74D"
                android:text="Go to Food Shop 🥣 ➔"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
